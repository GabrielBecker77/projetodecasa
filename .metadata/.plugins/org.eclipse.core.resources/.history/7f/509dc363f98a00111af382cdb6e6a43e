import java.util.ArrayList;
import java.util.Scanner;

public class Rascunhotres {

    public static void main(String[] args) {

        Scanner teclado = new Scanner(System.in);

        ArrayList<Double> tempMax = new ArrayList<>();
        ArrayList<Double> tempMin = new ArrayList<>();

        System.out.println("Digite as temperaturas da semana:");

        for (int i = 0; i < 7; i++) {
            System.out.printf("Dia %d%n", i + 1);

            System.out.print("Temperatura máxima: ");
            tempMax.add(teclado.nextDouble());

            System.out.print("Temperatura mínima: ");
            tempMin.add(teclado.nextDouble());
        }

        localizarMaiorTemperatura(tempMax);
        localizarMenorTemperatura(tempMin);

        teclado.close();
    }

    public static void localizarMaiorTemperatura(ArrayList<Double> lista) {
        double maior = lista.get(0);

        for (double temp : lista) {
            if (temp > maior) {
                maior = temp;
            }
        }

        mostrarTemperatura("Maior temperatura", maior);
    }

    public static void localizarMenorTemperatura(ArrayList<Double> lista) {
        double menor = lista.get(0);

        for (double temp : lista) {
            if (temp < menor) {
                menor = temp;
            }
        }

        mostrarTemperatura("Menor temperatura", menor);
    }

    public static void mostrarTemperatura(String mensagem, double temperatura) {
        System.out.printf("%s da semana: %.1f°C%n", mensagem, temperatura);
    }
}